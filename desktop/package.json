{
  "name": "aio-pos-desktop",
  "productName": "AIO POS",
  "version": "1.0.0",
  "description": "AIO POS for Windows — billing, inventory and business management",
  "author": "PBT Code Labs",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "31.3.1",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.pbtcodelabs.aiopos.desktop",
    "productName": "AIO POS",
    "copyright": "PBT Code Labs",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "offline.html", "app-config.json", "build/icon.png"],
    "win": { "target": ["nsis"], "icon": "build/icon.png" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AIO POS",
      "artifactName": "AIO-POS-Setup.exe"
    }
  }
}
